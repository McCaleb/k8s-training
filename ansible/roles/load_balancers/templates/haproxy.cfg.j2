# /etc/haproxy/haproxy.cfg
# Kubernetes API server load balancer.

global
    # sends logs to journald thorugh foreground process
    log             stdout format raw local0 info
    # confine the worker after startup
    chroot          /var/lib/haproxy                
    stats socket    /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout   30s
    user            haproxy
    group           haproxy
    maxconn         4096
    # cap on old workers lingering after a reload
    hard-stop-after 15m                             
    # No 'daemon': Debian runs 'haproxy -Ws' (foreground) and log stdout needs it.

defaults
    log     global
    # L4 pass-through: never terminate TLS (breaks mTLS auth)
    mode    tcp                                     
    option  tcplog
    option  dontlognull
    # retry a failed *connect* on a different server
    option  redispatch                              
    retries 3
    timeout connect 5s
    # default 50s kills kubectl exec / port-forward
    timeout client  4h                              
    timeout server  4h
    timeout check   5s
    # ~9s to mark a node DOWN
    default-server inter 3s fall 3 rise 2           

frontend k8s_apiserver
    # wildcard, so HAProxy starts without holding the VIP
    bind *:6443                                     
    default_backend k8s_controlplane

backend k8s_controlplane
    # /readyz fails first on SIGTERM; /livez would not
    option httpchk GET /readyz   
    # without this, a 500 counts as healthy                   
    http-check expect status 200                    
    balance leastconn
{% for host in groups['control_nodes'] %}
    server {{ host.split('.')[0] }} {{ hostvars[host].ansible_host }}:6443 check check-ssl verify none
{% endfor %}

frontend stats
    # separate listener: stats needs mode http
    bind {{ ansible_host }}:8404                                     
    mode http
    # overrides the inherited tcplog
    option httplog       
    # Skips the log line for any session that completed normally, logs everything else.                           
    option dontlog-normal
    stats enable
    stats uri /stats
    stats refresh 10s
