apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ansible_facts['default_ipv4']['address']}}"
  bindPort: 6443
nodeRegistration:
  name: {{ ansible_facts['hostname'] }}
  criSocket: "unix:///run/containerd/containerd.sock"
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: dev-homelab
controlPlaneEndpoint: "{{ vip_hostname }}.{{ vip_domain }}:6443"
apiServer:
  certSANs:
    - "{{ vip_hostname }}.{{ vip_domain }}"
    - "{{ vip_hostname }}"
{% for cn_ip in groups['control_nodes'] %}
    - "{{ cn_ip }}"
{% endfor %}
  extraArgs:
    - name: shutdown-delay-duration
      value: 15s
    - name: goaway-chance
      value: "0.001"
networking:
  podSubnet: "{{ pod_cidr }}"
  serviceSubnet: "{{ service_cidr }}"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
